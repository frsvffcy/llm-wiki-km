<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.5</version>
        <relativePath/>
    </parent>

    <groupId>org.km</groupId>
    <artifactId>llm-wiki-km</artifactId>
    <version>0.2.1</version>
    <name>llm-wiki-km</name>
    <description>Local-first personal knowledge base</description>

    <properties>
        <java.version>21</java.version>
        <!-- Reproducible release artifact contract (Refs #430 §B).
             Pinned UTC timestamp for deterministic JAR bytes: Maven JAR /
             Spring Boot repackage plugins normalize entry timestamps from this
             single authority. It is not runtime currentness data and must never
             be replaced by dynamic build-time data to chase bit-identical bytes.
             Procedure version: release-candidate-procedure-v1. -->
        <project.build.outputTimestamp>2026-09-15T00:00:00Z</project.build.outputTimestamp>
        <sqlite-jdbc.version>3.50.3.0</sqlite-jdbc.version>
        <tika.version>3.2.3</tika.version>
        <pdfbox.version>3.0.5</pdfbox.version>
        <arcadedb.version>26.9.1</arcadedb.version>
        <nitrite.version>4.3.0</nitrite.version>
        <!-- Empty by default: mvn test runs the complete regression suite. Profiles below
             set these to JUnit 5 tags for intentionally narrower feedback loops. -->
        <test.tags.include></test.tags.include>
        <test.tags.exclude></test.tags.exclude>
        <!-- The dedicated build-integrity profile changes this explicit switch. It skips only
             test execution; test compilation and the complete clean Maven lifecycle remain. -->
        <test.execution.skip>false</test.execution.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-jdbc</artifactId>
        </dependency>

        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>${sqlite-jdbc.version}</version>
        </dependency>

        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.tika</groupId>
            <artifactId>tika-core</artifactId>
            <version>${tika.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.tika</groupId>
            <artifactId>tika-parsers-standard-package</artifactId>
            <version>${tika.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>${pdfbox.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.networknt</groupId>
            <artifactId>json-schema-validator</artifactId>
            <version>1.5.9</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jooq</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jooq</groupId>
            <artifactId>jooq-codegen</artifactId>
        </dependency>
        <dependency>
            <groupId>com.arcadedb</groupId>
            <artifactId>arcadedb-engine</artifactId>
            <version>${arcadedb.version}</version>
        </dependency>
    </dependencies>

    <build>
        <!-- R1 single version truth (Refs #456): version.properties is the only
             generated runtime version authority, filtered from pom.xml
             project.version at build time. Only @...@ is a delimiter so
             Spring ${...} placeholders elsewhere are never touched; every
             other resource is copied unfiltered and byte-identical. -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>version.properties</exclude>
                </excludes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>version.properties</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <configuration>
                    <delimiters>
                        <delimiter>@</delimiter>
                    </delimiters>
                    <useDefaultDelimiters>false</useDefaultDelimiters>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>compile-jooq-codegen-bootstrap</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                        <configuration>
                            <includes>
                                <include>db/migration/V3__BackfillDocumentFileNames.java</include>
                                <include>org/km/llmwiki/persistence/jooq/JooqCodeGenerator.java</include>
                            </includes>
                            <outputDirectory>${project.build.directory}/jooq-codegen-classes</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <id>generate-jooq-sources</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>org.km.llmwiki.persistence.jooq.JooqCodeGenerator</mainClass>
                            <arguments>
                                <argument>${project.build.directory}/generated-sources/jooq</argument>
                            </arguments>
                            <classpathScope>compile</classpathScope>
                            <additionalClasspathElements>
                                <additionalClasspathElement>${project.build.directory}/jooq-codegen-classes</additionalClasspathElement>
                                <additionalClasspathElement>${project.basedir}/src/main/resources</additionalClasspathElement>
                            </additionalClasspathElements>
                        </configuration>
                    </execution>
                    <execution>
                        <!-- #481 Browser static-asset currentness: stamp content-hash query
                             tokens into the packaged index.html so a revalidated document
                             after an upgrade forces compulsory cache misses for changed
                             JS/CSS (heuristic disk hits send no request and can never be
                             fixed by response headers alone). Runs at process-classes so
                             it sees the copied resources and still precedes packaging and
                             spring-boot:run; the token is a pure function of file content
                             (reproducible builds unaffected). -->
                        <id>version-static-assets</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>org.km.llmwiki.web.StaticAssetVersioner</mainClass>
                            <arguments>
                                <argument>${project.build.outputDirectory}/static</argument>
                            </arguments>
                            <classpathScope>compile</classpathScope>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <id>add-jooq-sources</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>${project.build.directory}/generated-sources/jooq</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.3</version>
                <configuration>
                    <groups>${test.tags.include}</groups>
                    <excludedGroups>${test.tags.exclude}</excludedGroups>
                    <skipTests>${test.execution.skip}</skipTests>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>fast</id>
            <properties>
                <test.tags.include>unit,contract</test.tags.include>
                <test.tags.exclude>integration</test.tags.exclude>
            </properties>
        </profile>
        <profile>
            <id>integration</id>
            <properties>
                <test.tags.include>integration</test.tags.include>
                <test.tags.exclude></test.tags.exclude>
            </properties>
        </profile>
        <profile>
            <id>full</id>
            <properties>
                <!-- Deliberately no tag filter: this is the complete regression/build gate. -->
                <test.tags.include></test.tags.include>
                <test.tags.exclude></test.tags.exclude>
            </properties>
        </profile>
        <profile>
            <id>build-integrity</id>
            <properties>
                <!-- This CI evidence profile intentionally skips execution only. Running
                     clean verify still performs Flyway-backed jOOQ generation, compilation,
                     packaging, and verification from a clean workspace. -->
                <test.execution.skip>true</test.execution.skip>
            </properties>
        </profile>
        <profile>
            <id>graph-adapter-spike</id>
            <properties>
                <!-- The spike is opt-in and intentionally excludes the normal regression tiers. -->
                <test.tags.include>graph-spike</test.tags.include>
                <test.tags.exclude></test.tags.exclude>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>org.dizitart</groupId>
                    <artifactId>nitrite</artifactId>
                    <version>${nitrite.version}</version>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>org.dizitart</groupId>
                    <artifactId>nitrite-mvstore-adapter</artifactId>
                    <version>${nitrite.version}</version>
                    <scope>test</scope>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>add-graph-adapter-spike-test-sources</id>
                                <phase>generate-test-sources</phase>
                                <goals>
                                    <goal>add-test-source</goal>
                                </goals>
                                <configuration>
                                    <sources>
                                        <source>${project.basedir}/src/test/java-graph-adapter-spike</source>
                                    </sources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
