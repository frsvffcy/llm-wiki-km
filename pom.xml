<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.5</version>
        <relativePath/>
    </parent>

    <groupId>org.km</groupId>
    <artifactId>llm-wiki-km</artifactId>
    <version>0.1.0</version>
    <name>llm-wiki-km</name>
    <description>Local-first personal knowledge base</description>

    <properties>
        <java.version>21</java.version>
        <sqlite-jdbc.version>3.50.3.0</sqlite-jdbc.version>
        <tika.version>3.2.3</tika.version>
        <pdfbox.version>3.0.5</pdfbox.version>
        <!-- Empty by default: mvn test runs the complete regression suite. Profiles below
             set these to JUnit 5 tags for intentionally narrower feedback loops. -->
        <test.tags.include></test.tags.include>
        <test.tags.exclude></test.tags.exclude>
        <!-- The dedicated build-integrity profile changes this explicit switch. It skips only
             test execution; test compilation and the complete clean Maven lifecycle remain. -->
        <test.execution.skip>false</test.execution.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-jdbc</artifactId>
        </dependency>

        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>${sqlite-jdbc.version}</version>
        </dependency>

        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.tika</groupId>
            <artifactId>tika-core</artifactId>
            <version>${tika.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.tika</groupId>
            <artifactId>tika-parsers-standard-package</artifactId>
            <version>${tika.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>${pdfbox.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jooq</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jooq</groupId>
            <artifactId>jooq-codegen</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>compile-jooq-codegen-bootstrap</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                        <configuration>
                            <includes>
                                <include>db/migration/V3__BackfillDocumentFileNames.java</include>
                                <include>org/km/llmwiki/persistence/jooq/JooqCodeGenerator.java</include>
                            </includes>
                            <outputDirectory>${project.build.directory}/jooq-codegen-classes</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <id>generate-jooq-sources</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>org.km.llmwiki.persistence.jooq.JooqCodeGenerator</mainClass>
                            <arguments>
                                <argument>${project.build.directory}/generated-sources/jooq</argument>
                            </arguments>
                            <classpathScope>compile</classpathScope>
                            <additionalClasspathElements>
                                <additionalClasspathElement>${project.build.directory}/jooq-codegen-classes</additionalClasspathElement>
                                <additionalClasspathElement>${project.basedir}/src/main/resources</additionalClasspathElement>
                            </additionalClasspathElements>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <id>add-jooq-sources</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>${project.build.directory}/generated-sources/jooq</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.3</version>
                <configuration>
                    <groups>${test.tags.include}</groups>
                    <excludedGroups>${test.tags.exclude}</excludedGroups>
                    <skipTests>${test.execution.skip}</skipTests>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>fast</id>
            <properties>
                <test.tags.include>unit,contract</test.tags.include>
                <test.tags.exclude>integration</test.tags.exclude>
            </properties>
        </profile>
        <profile>
            <id>integration</id>
            <properties>
                <test.tags.include>integration</test.tags.include>
                <test.tags.exclude></test.tags.exclude>
            </properties>
        </profile>
        <profile>
            <id>full</id>
            <properties>
                <!-- Deliberately no tag filter: this is the complete regression/build gate. -->
                <test.tags.include></test.tags.include>
                <test.tags.exclude></test.tags.exclude>
            </properties>
        </profile>
        <profile>
            <id>build-integrity</id>
            <properties>
                <!-- This CI evidence profile intentionally skips execution only. Running
                     clean verify still performs Flyway-backed jOOQ generation, compilation,
                     packaging, and verification from a clean workspace. -->
                <test.execution.skip>true</test.execution.skip>
            </properties>
        </profile>
    </profiles>
</project>
